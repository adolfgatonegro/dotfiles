#!/bin/sh

control-centre(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg panel-toggle control-center ;;
		dms) dms ipc call control-center toggle ;;
	esac
}

notifications(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg panel-toggle control-center notifications ;;
		dms) dms ipc call notifications toggle ;;
	esac
}

clipboard(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg panel-toggle clipboard ;;
		dms) dms ipc call clipboard toggle ;;
	esac
}

emoji(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg panel-toggle launcher "/emo" ;;
		dms) notify-send "shellctl emoji" "Command not configured."  ;;
	esac
}

lock-screen(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg session lock ;;
		dms) dms ipc call lock lock ;;
	esac
}

session-menu(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg panel-toggle session ;;
		dms) dms ipc call powermenu toggle ;;
	esac
}

volume-up(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg volume-up 2 ;;
		dms) dms ipc call audio increment 2 ;;
	esac
}

volume-down(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg volume-down 2 ;;
		dms) dms ipc call audio decrement 2 ;;
	esac
}

volume-mute-output(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg volume-mute ;;
		dms) dms ipc call audio mute ;;
	esac
}

volume-mute-input(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg mic-mute ;;
		dms) dms ipc call audio micmute ;;
	esac
}

mpris-play-pause(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg media toggle ;;
		dms) dms ipc call mpris playPause ;;
	esac
}

mpris-stop(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg media stop ;;
		dms) dms ipc call mpris stop ;;
	esac
}

mpris-previous(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg media previous ;;
		dms) dms ipc call mpris previous ;;
	esac
}

mpris-next(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg media next ;;
		dms) dms ipc call mpris next ;;
	esac
}

brightness-up(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg brightness-up ;;
		dms) dms ipc call brightness increment 5 "";;
	esac
}

brightness-down(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg brightness-down ;;
		dms) dms ipc call brightness decrement 5 "" ;;
	esac
}

screen-record(){
	case $WAYLAND_SHELL in
		noctalia) noctalia msg plugin noctalia/screen_recorder:service all toggle ;;
		dms) notify-send "shellctl screen-record" "Command not configured." ;;
	esac
}

case "$1" in
	control-centre) control-centre ;;
	notifications) notifications ;;
	clipboard) clipboard ;;
	emoji) emoji ;;
	lock-screen) lock-screen ;;
	session-menu) session-menu ;;
	volume-up) volume-up ;;
	volume-down) volume-down ;;
	volume-mute-output) volume-mute-output ;;
	volume-mute-input) volume-mute-input ;;
	mpris-play-pause) mpris-play-pause ;;
	mpris-stop) mpris-stop ;;
	mpris-previous) mpris-previous ;;
	mpris-next) mpris-next ;;
	brightness-up) brightness-up ;;
	brightness-down) brightness-down ;;
	screen-record) screen-record ;;
	*) echo "What are you even trying to do?" ;;
esac
